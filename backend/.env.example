# 火山引擎 ARK API 配置
# 前往 https://console.volcengine.com/ark 获取 API Key
API_KEY=your_api_key_here
BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL=doubao-seed-2-0-lite-260215
# 片名、会议摘要、Story IR 和 Word 镜号规划使用的轻量模型
SIMPLE_MODEL=doubao-seed-2-0-lite-260428
# 方舟结构化 JSON Agent 的思考模式：disabled / auto / enabled
STRUCTURED_MODEL_THINKING=disabled
# 主模型额度耗尽时自动切换的备用模型（同 API Key，同 BASE_URL）
FALLBACK_MODEL=doubao-seed-2-0-mini-260215

# 摄影指导智能体（三阶段：镜头描述 → 站位规划 → 摄影机分配）
ENABLE_CINEMATOGRAPHY=true
# 可选：单独指定摄影智能体使用的模型（不填则复用 MODEL）
# CINEMATOGRAPHY_MODEL=

# 可选：单独指定动作与表情专项智能体使用的模型（不填则复用 MODEL）
# PERFORMANCE_MODEL=
